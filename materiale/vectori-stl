<script>
/* iterator demo */
(() => {
  const root = document.getElementById('demoIt'); if (!root) return;
  Stepper(root, () => {
    const v = [5, 2, 8, 1, 9], arr = v.concat([null]), frames = [];
    let s = 0;
    const stats = () => `<div><span>s =</span> <b>${s}</b></div>`;
    frames.push({ l: 0, ln: 'it', msg: 'Pornim cu <b>it = v.begin()</b>, care arată spre primul element. Suma este s = 0.', stats: stats() });
    for (let k = 0; k < v.length; k++) {
      s += v[k];
      frames.push({ l: k, ln: 'it', done: j => j < k, msg: `it != v.end(), deci intrăm în buclă: <b>*it = ${v[k]}</b>, iar s devine ${s}.`, stats: stats() });
      frames.push({ l: k + 1, ln: 'it', done: j => j <= k, msg: k + 1 < v.length ? `<b>++it</b>: iteratorul trece la elementul următor.` : `<b>++it</b>: iteratorul a ajuns la <b>v.end()</b>, poziția de după ultimul element.`, stats: stats() });
    }
    frames.push({ l: v.length, ln: 'it', done: j => j < v.length, msg: `it == v.end(), deci bucla se oprește. <span class="ok">Suma este ${s}.</span> Observați că nu am citit niciodată <b>*v.end()</b>.`, stats: stats() });
    return { arr, frames };
  });
})();

/* quiz */
(() => {
  const host = document.getElementById('quiz'); if (!host) return;
  const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const Q = [
    { q: 'Ce afișează codul?', code: 'vector<int> v = {4, 7, 1};\nv.push_back(3);\ncout << v.size();', o: ['3', '4', '7', '1'], c: 1, e: 'Vectorul avea 3 elemente, push_back a adăugat încă unul, deci size() este 4.' },
    { q: 'Spre ce arată v.end()?', o: ['spre ultimul element', 'spre poziția de după ultimul element', 'spre primul element', 'spre elementul de pe poziția size()-1'], c: 1, e: 'v.end() arată după ultimul element. Acolo nu există niciun element, de aceea nu scriem *v.end().' },
    { q: 'Ce afișează codul?', code: 'vector<int> v(5);\ncout << v[2];', o: ['5', '2', '0', 'o valoare oarecare („gunoi”)'], c: 2, e: 'vector<int> v(5) creează 5 elemente egale cu 0.' },
    { q: 'Ce afișează codul?', code: 'vector<int> v = {5, 3, 9, 1};\nsort(v.begin(), v.end());\ncout << v[0] << " " << v.back();', o: ['5 1', '1 9', '9 1', '1 5'], c: 1, e: 'După sortare vectorul este 1 3 5 9: primul element este 1, ultimul este 9.' },
    { q: 'După bucla de mai jos, ce conține v?', code: 'vector<int> v = {1, 2, 3};\nfor (int x : v)\n    x = x * 10;', o: ['10 20 30', '1 2 3', '0 0 0', 'programul nu se compilează'], c: 1, e: 'x este o copie a fiecărui element, deci v nu se modifică. Pentru modificare trebuia scris int &x.' },
    { q: 'Cum aflăm poziția (indicele) spre care arată un iterator it?', o: ['*it', 'it - v.begin()', 'v.end() - it', 'it + 1'], c: 1, e: 'Diferența dintre doi iteratori este numărul de poziții dintre ei, deci it - v.begin() este indicele.' },
    { q: 'Ce afișează codul?', code: 'vector<int> v = {6, 2, 8};\nauto it = max_element(v.begin(), v.end());\ncout << *it << " " << it - v.begin();', o: ['8 2', '8 3', '2 8', '6 0'], c: 0, e: 'Maximul este 8, aflat pe poziția 2 (numărăm de la 0).' },
  ];
  const answered = {};
  const score = () => {
    const done = Object.keys(answered).length, ok = Object.values(answered).filter(Boolean).length;
    document.getElementById('quizScore').textContent = done ? `Răspunsuri corecte: ${ok} din ${Q.length}` : '';
  };
  Q.forEach((it, qi) => {
    const box = document.createElement('div'); box.className = 'qz';
    let html = `<p class="qz-q"><span class="qz-n">${qi + 1}.</span> ${esc(it.q)}</p>`;
    if (it.code) html += `<pre class="qz-code">${esc(it.code)}</pre>`;
    html += '<div class="qz-opts">' + it.o.map((t, oi) => `<label for="q${qi}o${oi}"><input type="radio" name="q${qi}" id="q${qi}o${oi}" value="${oi}"> <span>${esc(t)}</span></label>`).join('') + '</div>';
    html += `<p class="qz-fb" aria-live="polite"></p>`;
    box.innerHTML = html;
    const fb = box.querySelector('.qz-fb');
    box.querySelectorAll('input').forEach(inp => inp.addEventListener('change', () => {
      const ok = Number(inp.value) === it.c;
      answered[qi] = ok;
      box.querySelectorAll('label').forEach((lb, li) => { lb.classList.toggle('right', li === it.c && ok); lb.classList.toggle('wrong', !ok && li === Number(inp.value)); });
      fb.innerHTML = ok ? '<b class="ok">Corect.</b> ' + esc(it.e) : '<b class="bad">Nu chiar.</b> Mai încercați.';
      score();
    }));
    host.appendChild(box);
  });
})();


